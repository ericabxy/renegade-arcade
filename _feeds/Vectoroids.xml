<?xml version="1.0"?>
<?xml-stylesheet type='text/xsl' href='feed.xsl'?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>Vectoroids</name>
  <summary>A clone of the classic arcade game "Asteroids" by Atari.</summary>

  <description>
    Your objective is to maneuver a space ship within a field of asteroids, and shoot them into smaller and smaller pieces, eventually destroying them completely.
  </description>

  <icon href="https://newbreedsoftware.com/images/prodicons/vectoroids.gif" type="image/png"/>

  <homepage>https://newbreedsoftware.com/vectoroids/</homepage>

  <feed-for interface="https://arcade.radicalgnu.xyz/Vectoroids"/>

  <group license="GNU General Public License v2.0">

    <implementation version="{version}" released="{released}" stability="stable">
      <manifest-digest />
      <archive href="https://tuxpaint.org/ftp/unix/x/vectoroids/src/vectoroids-{version}.tar.gz"/>
    </implementation>
  </group>
</interface>
